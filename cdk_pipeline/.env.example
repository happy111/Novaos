# AR model-training pipeline — environment config (Dev-scoped MVP).
#
# Copy this file to .env (gitignored), then before running:
#     set -a; source .env; set +a
#
# These are the real Dev-account values already in use for this workload — no
# secrets here (bucket names, ARNs, and resource IDs only). Per NTU-980,
# nothing account-specific should be hardcoded in Python source; it all comes
# from here instead.

# --- Required ---
AWS_REGION=us-east-1
# Account-specific artifact/report bucket (pipeline outputs — prep/eval/bias/
# model artifacts). The labeled DATASET lives in a SEPARATE, derived bucket —
# see ENV / APP_PREFIX below.
AR_ARTIFACT_BUCKET=novartis-970547336770-dev-us-east-1-novos-ar-model-training
# The two variable components of the dataset bucket's name:
# novartis-{account_id}-{ENV}-{region}-{APP_PREFIX}-mrd-datasets
# (see config.dataset_bucket_name()). The dataset itself then sits at
# <bucket>/<model_name>/<data.source.s3_prefix>/<version>/ — s3_prefix is
# authored in the YAML, not read from the environment.
#
# Unprefixed on purpose: these are the platform-wide names the pipeline Lambdas
# already carry from cdk_pipeline/environments/<env>.json, so the code reads one
# pair of names whether it runs here or in Lambda.
ENV=dev
APP_PREFIX=novos-ar
# VPC placement for every Processing/Training job this pipeline creates — the
# account routes S3/ECR/CloudWatch Logs through VPC endpoints, so a job with no
# VPC config fails at the network layer before any container code runs. Same
# values every sibling pipeline's CDK stack uses (network.security_groups.lambda
# / network.subnet_groups.routable in cdk_pipeline/environments/<env>.json).
# Comma-separated, no spaces.
AR_VPC_SECURITY_GROUP_IDS=sg-0fff0e9160460002d,sg-058e35b74a696bc80,sg-0edb0104034149a34
AR_VPC_SUBNET_IDS=subnet-0537c8dda74f4723b,subnet-0811c3073b6ae7f26

# --- Optional (empty = documented default) ---
# Where training artifacts land under the bucket. Empty -> "model-training"
# (the model name is appended per-resource; no app/env prefix).
AR_ARTIFACT_PREFIX=model-training
# CMK ARN for artifact/volume encryption. Empty -> SSE-S3 (SageMaker default).
# Leave empty unless the execution role holds kms:CreateGrant on the key.
AR_KMS_KEY_ARN=
# Execution role ARN. Empty -> resolve the caller's Studio role at runtime.
AR_EXECUTION_ROLE_ARN=arn:aws:iam::970547336770:role/RRDRAR65_AWS_APP01_PWSA0002037
# SageMaker Unified Studio (DataZone) placement. Set BOTH so the pipeline and the
# registered model package appear under the AR project in Unified Studio (they're
# omitted if unset — resources still exist in classic Studio). Read off an existing
# Unified Studio AR resource's tags. Empty -> not tagged for Unified Studio.
AR_DATAZONE_DOMAIN_ID=dzd-c3poc7rfn8nyw7
AR_DATAZONE_PROJECT_ID=do9axtshgp150n
# Project scope (the environment within the project, e.g. dev/prod). A
# console-visible Unified Studio model carries this alongside domain+project.
# Empty -> defaults to "dev".
AR_DATAZONE_SCOPE_NAME=
